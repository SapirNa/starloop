# Copy this file to .env (git-ignored) and fill in real values before a
# production release build. Until these are set, StarLoop always falls back
# to Google's test ads - see src/services/ads/config.ts.

# Rewarded and Interstitial Ad Unit IDs from the AdMob console, per
# platform. These are the *runtime* ad-unit values (distinct from the
# native AdMob App ID, which is set separately via ADMOB_ANDROID_APP_ID /
# ADMOB_IOS_APP_ID - see app.config.js).
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=

# Native AdMob App IDs (embedded into the Android manifest / iOS Info.plist
# at build time by the react-native-google-mobile-ads config plugin - see
# app.config.js). Not EXPO_PUBLIC_-prefixed: only read at build time, never
# needs to reach the client JS bundle.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
